{
  "name": "secret-vibez-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite frontend --port=5173 --host=0.0.0.0",
    "dev:backend": "tsx watch backend/src/server.ts",
    "build": "vite build frontend",
    "preview": "vite preview frontend",
    "clean": "rm -rf dist backend/dist",
    "lint": "tsc --noEmit --project frontend/tsconfig.json",
    "db:migrate": "npx prisma migrate dev --schema=backend/prisma/schema.prisma",
    "db:seed": "tsx backend/prisma/seed.ts",
    "db:generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@google/genai": "^1.29.0",
    "@prisma/client": "^6.3.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.66.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcrypt": "^5.1.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.1.5",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vite": "^6.2.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.0.5"
  }
}
